APP_NAME="Slevohlídka"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:54720

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker (compose.yaml) — z hostitele je databáze na localhost:54721
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=agregator
DB_USERNAME=agregator
DB_PASSWORD=agregator

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Fronta a scheduler závisí na hostingu (O1 v docs/PLAN.md) — zatím vše synchronně
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Lokálně se e-maily (obnova hesla) jen zapisují do storage/logs/laravel.log
# Lokálně do Mailpitu (http://localhost:54723), nic neodejde ven
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="letaky@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Veřejný klíč e-shopu Tesco (mangoApiKey v HTML nakup.itesco.cz), viz docs/ZDROJE_DAT.md
TESCO_API_KEY=

# Token cron URL (/cron/import-offers?chain=…&token=…) — lokálně není potřeba, prázdný URL vypíná
LETAKY_CRON_TOKEN=

# Upozornění v telefonu — web push (R66). Klíče vygeneruje: docker compose exec app php artisan letaky:push-keys
# Prázdné = upozornění vypnutá (přepínač v účtu se neukáže)
LETAKY_VAPID_PUBLIC_KEY=
LETAKY_VAPID_PRIVATE_KEY=

# Přihlášení přes Google a Facebook (R96) — klíče aplikací z Google Cloud Console a Meta for Developers
# (postup v deploy/DEPLOYMENT.md). Prázdné = tlačítko poskytovatele se neukáže
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
