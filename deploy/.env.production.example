# Slevohlídka — .env pro produkci (Websupport, slevohlidka.rhsoft.cz)
# Zkopíruj na hosting jako `.env` (bez BOM!) a vyplň místa označená <…>.
#
# @author Roman Hlaváček
# @created 2026-10-02

APP_NAME="Slevohlídka"
APP_ENV=production
APP_KEY=<docker compose exec app php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://slevohlidka.rhsoft.cz

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Údaje z detailu databáze ve WebAdminu
DB_CONNECTION=mariadb
DB_HOST=<host databáze>
DB_PORT=3306
DB_DATABASE=<název databáze>
DB_USERNAME=<uživatel>
DB_PASSWORD=<heslo>

# Session v databázi (R13) — přihlášení jde zrušit smazáním řádku
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Web jde jen přes HTTPS (public/.htaccess, R38) — cookie neposílat po HTTP
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Fronta ani scheduler na hostingu nejsou (R20) — vše synchronně
QUEUE_CONNECTION=sync
CACHE_STORE=database

# E-maily (obnova hesla) přes SMTP Websupportu — schránka založená ve WebAdminu
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.websupport.cz
MAIL_PORT=465
MAIL_USERNAME=<adresa schránky>
MAIL_PASSWORD=<heslo schránky>
MAIL_FROM_ADDRESS=<adresa schránky>
MAIL_FROM_NAME="${APP_NAME}"

# Veřejný klíč e-shopu Tesco (mangoApiKey v HTML nakup.itesco.cz), viz docs/ZDROJE_DAT.md
TESCO_API_KEY=<klíč>

# Token cron URL (/cron/import-offers?chain=…&token=…, R38):
#   docker compose exec app php -r "echo bin2hex(random_bytes(24));"
LETAKY_CRON_TOKEN=<token>
# Google Analytics 4 (R52) — výchozí ID je v config/letaky.php, prázdné = měření vypnuté
# LETAKY_GA_MEASUREMENT_ID=G-BM3CZ7M4PD

# Upozornění v telefonu — web push (R66). Vygenerovat JEDNOU lokálně a už neměnit
# (nové klíče zneplatní všechny odběry): docker compose exec app php artisan letaky:push-keys
# Prázdné = upozornění vypnutá (přepínač v Můj účet se neukáže)
LETAKY_VAPID_PUBLIC_KEY=<veřejný klíč>
LETAKY_VAPID_PRIVATE_KEY=<soukromý klíč>
